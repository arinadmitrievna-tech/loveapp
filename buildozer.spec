[app]

# Название приложения
title = LoveApp

# Имя пакета
package.name = loveapp

# Домен приложения
package.domain = org.loveapp

# Папка с main.py и ресурсами
source.dir = .

# Какие файлы включать в APK
source.include_exts = py,png,jpg,jpeg,otf,ttf

# Версия
version = 0.1

# Зависимости
requirements = python3,kivy

# Ориентация телефона
orientation = portrait

# Не показывать консоль
fullscreen = 0


[buildozer]

# Уровень логов
log_level = 2
